<Project>
  <!--
    Shared build settings. Component versions are pinned in one place, versions.json, and read from it here, so
    IDE / `dotnet build` runs use the same versions as build\package.ps1 (which may also pass them in).
  -->
  <PropertyGroup>
    <VersionsJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)versions.json'))</VersionsJson>
    <SyscomVersion Condition="'$(SyscomVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match($(VersionsJson), '"syscom"\s*:\s*"([^"]+)"').Groups[1].Value)</SyscomVersion>
    <LhmVersion Condition="'$(LhmVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match($(VersionsJson), '"librehardwaremonitor"\s*:\s*"([^"]+)"').Groups[1].Value)</LhmVersion>
    <WindowsServicesVersion Condition="'$(WindowsServicesVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match($(VersionsJson), '"windowsServices"\s*:\s*"([^"]+)"').Groups[1].Value)</WindowsServicesVersion>

    <TargetFramework>net10.0</TargetFramework>
    <Version>$(SyscomVersion)</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Company>SYSCOM</Company>
    <Product>SYSCOM</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Every DLL in the install folder is loaded as-is (no deps.json pinning), so a component can be
         replaced by dropping in a newer file. A bad drop-in fails the updater's health check and is rolled back. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>

    <!-- The executables look for the bundled .NET runtime in .\runtime next to them (no system-wide install). -->
    <AppHostDotNetSearch>AppRelative</AppHostDotNetSearch>
    <AppHostRelativeDotNet>runtime</AppHostRelativeDotNet>
  </PropertyGroup>

  <!-- Windows builds: everything targets win-x64 so Windows-only packages resolve. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <SelfContained>false</SelfContained>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
</Project>
